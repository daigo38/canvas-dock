root = Container([page], "xl")
page = Stack([hero, intro, bc, gallery, foot], "column", 8)

hero = Hero("Canvas Dock — Component Gallery", "All 39 OpenUI Lang components in one page. A visual reference and syntax cheat sheet for AI agents.")
intro = Lead("Themes only change CSS variables — component shapes are identical across all 7 themes.")
bc = Breadcrumb([{text: "Canvas Dock"}, {text: "Component Gallery"}])

gallery = Stack([layoutH, layoutBody, gd1, typeH, typeBody, gd2, surfH, surfBody, gd3, dataH, dataBody, gd4, interH, interBody, gd5, mediaH, mediaBody], "column", 8)
gd1 = Divider()
gd2 = Divider()
gd3 = Divider()
gd4 = Divider()
gd5 = Divider()

// ===== LAYOUT (7) =====
layoutH = Heading("Layout (7)", 2)
layoutBody = Grid([cardStack, cardContainer, cardGrid, cardSpacer, cardAspect, cardScroll, cardDivider], 2, 4)

cardStack = Card([stackInner], "Stack", "Stack([a, b, c], \"row\", 2)")
stackInner = Stack([sb1, sb2, sb3], "row", 2)
sb1 = Badge("alpha")
sb2 = Badge("beta")
sb3 = Badge("gamma")

cardContainer = Card([containerText], "Container", "Container([page], \"xl\")")
containerText = Text("This page is wrapped in Container(\"xl\"). Sizes: sm | md | lg | xl | 2xl | full.", true)

cardGrid = Card([gridInner], "Grid", "Grid([a, b, c, d], 4, 2)")
gridInner = Grid([gb1, gb2, gb3, gb4], 4, 2)
gb1 = Badge("1")
gb2 = Badge("2")
gb3 = Badge("3")
gb4 = Badge("4")

cardSpacer = Card([spacerAbove, spacerInst, spacerBelow], "Spacer", "Spacer(8)")
spacerAbove = Text("Above")
spacerInst = Spacer(8)
spacerBelow = Text("Below (8 units of vertical space above)")

cardAspect = Card([aspectInner], "AspectRatio", "AspectRatio(children, \"16:9\")")
aspectInner = AspectRatio([aspectImg], "16:9")
aspectImg = Image("/icon.png", "icon", false)

cardScroll = Card([scrollInner], "ScrollArea", "ScrollArea(children, 140)")
scrollInner = ScrollArea([scrollList], 140)
scrollList = NumberList(["Item 1", "Item 2", "Item 3", "Item 4", "Item 5", "Item 6", "Item 7", "Item 8", "Item 9", "Item 10", "Item 11", "Item 12"])

cardDivider = Card([divAbove, divInst, divBelow], "Divider", "Divider()")
divAbove = Text("Above")
divInst = Divider()
divBelow = Text("Below")

// ===== TYPOGRAPHY (8) =====
typeH = Heading("Typography (8)", 2)
typeBody = Stack([typeMain, typeRest], "column", 4)

typeMain = Card([typeMainStack], "Heading + Text + Lead + Quote")
typeMainStack = Stack([thH1, thH2, thH3, thH4, thText, thMuted, thLead, thQuote], "column", 3)
thH1 = Heading("Heading level 1", 1)
thH2 = Heading("Heading level 2", 2)
thH3 = Heading("Heading level 3", 3)
thH4 = Heading("Heading level 4", 4)
thText = Text("Standard body text — Text(\"...\").")
thMuted = Text("Muted body text — Text(\"...\", true).", true)
thLead = Lead("Lead paragraph — larger intro text via Lead(\"...\").")
thQuote = Quote("It must be possible to render any model output as a structured page.", "Canvas Dock")

typeRest = Grid([typeCode, typeBlock, typeLink, typeKbd], 2, 4)

typeCode = Card([typeCodeRow], "Code (inline)", "Code(\"text\")")
typeCodeRow = Stack([tcrLabel, tcrCode], "row", 2)
tcrLabel = Text("Use:")
tcrCode = Code("Stack([a, b], \"row\")")

typeBlock = Card([typeBlockSrc], "CodeBlock", "CodeBlock(text, language?)")
typeBlockSrc = CodeBlock("root = Stack([h, b], \"column\")\nh = Heading(\"Hello\", 1)\nb = Text(\"world\")", "openui")

typeLink = Card([typeLinkInst], "Link", "Link(text, href, external?)")
typeLinkInst = Link("Canvas Dock on GitHub", "https://github.com/daigo38/canvas-dock", true)

typeKbd = Card([typeKbdRow], "Kbd", "Kbd(\"⌘\")")
typeKbdRow = Stack([kbdLabel, kbdCmd, kbdPlus, kbdK], "row", 2, "center")
kbdLabel = Text("Try:")
kbdCmd = Kbd("⌘")
kbdPlus = Text("+")
kbdK = Kbd("K")

// ===== SURFACES (6) =====
surfH = Heading("Surfaces (6)", 2)
surfBody = Stack([surfAlerts, surfMisc, surfEmpty], "column", 4)

surfAlerts = Grid([alertInfo, alertWarn, alertError, alertSuccess], 2, 3)
alertInfo = Alert([aiText], "Info", "info")
aiText = Text("variant: info (default)")
alertWarn = Alert([awText], "Warning", "warn")
awText = Text("variant: warn")
alertError = Alert([aeText], "Error", "error")
aeText = Text("variant: error")
alertSuccess = Alert([asText], "Success", "success")
asText = Text("variant: success")

surfMisc = Grid([cardCard, cardBadge, cardAvatar, cardHero], 2, 3)

cardCard = Card([cardCardText], "Card", "Card(children, title?, description?)")
cardCardText = Text("You're looking at one right now.")

cardBadge = Card([badgesRow], "Badge", "Badge(text, tone?)")
badgesRow = Stack([bgDefault, bgSuccess, bgWarn, bgError], "row", 2)
bgDefault = Badge("default")
bgSuccess = Badge("success", "success")
bgWarn = Badge("warn", "warn")
bgError = Badge("error", "error")

cardAvatar = Card([avatarRow], "Avatar", "Avatar(name, src?, size?)")
avatarRow = Stack([av1, av2], "row", 4, "center")
av1 = Avatar("Alice Anderson")
av2 = Avatar("With image", "/icon.png", "lg")

cardHero = Card([heroText], "Hero", "Hero(title, subtitle?, children?)")
heroText = Text("Used as the page header — see top of this page.")

surfEmpty = EmptyState("EmptyState example", "Use this when a list or section has no data.", "📭")

// ===== DATA DISPLAY (8) =====
dataH = Heading("Data display (8)", 2)
dataBody = Stack([statsGrid, chartsGrid, tableDemo, listsGrid, defListDemo, progressDemo, timelineDemo], "column", 4)

statsGrid = Grid([stat1, stat2, stat3, stat4], 4, 3)
stat1 = Stat("Components", 39, "+30 since v0.1", "up")
stat2 = Stat("Themes", 7)
stat3 = Stat("Revenue", "$1.24M", "+12%", "up")
stat4 = Stat("Churn", "2.1%", "-0.4pp", "down")

chartsGrid = Grid([chartBarCard, chartLineCard, chartPieCard], 3, 3)
chartBarCard = Card([cbInner], "Chart bar")
cbInner = Chart("bar", [{name: "Jan", value: 32}, {name: "Feb", value: 41}, {name: "Mar", value: 48}, {name: "Apr", value: 53}])
chartLineCard = Card([clInner], "Chart line (multi)")
clInner = Chart("line", [{name: "Jan", a: 32, b: 24}, {name: "Feb", a: 41, b: 30}, {name: "Mar", a: 48, b: 38}, {name: "Apr", a: 53, b: 45}], "name", ["a", "b"])
chartPieCard = Card([cpInner], "Chart pie")
cpInner = Chart("pie", [{name: "JP", value: 420}, {name: "US", value: 510}, {name: "EU", value: 310}])

tableDemo = Card([tableInner], "Table")
tableInner = Table([{key: "vendor", label: "Vendor"}, {key: "score", label: "Score", align: "right"}, {key: "trend", label: "Trend", align: "center"}], [{vendor: "Acme", score: "98%", trend: "↑"}, {vendor: "Globex", score: "94%", trend: "↑"}, {vendor: "Initech", score: "91%", trend: "→"}, {vendor: "Soylent", score: "88%", trend: "↓"}])

listsGrid = Grid([bulletCard, numberCard], 2, 4)
bulletCard = Card([bulletInner], "BulletList", "BulletList([\"a\", \"b\"])")
bulletInner = BulletList(["Apple", "Banana", "Cherry", "Durian"])
numberCard = Card([numberInner], "NumberList", "NumberList([\"a\", \"b\"])")
numberInner = NumberList(["First", "Second", "Third", "Fourth"])

defListDemo = Card([defListInner], "DefinitionList")
defListInner = DefinitionList([{term: "Endpoint", definition: "POST /api/pages"}, {term: "Format", definition: "OpenUI Lang or A2UI v0.8"}, {term: "Themes", definition: "7 (default + 6 better-design)"}])

progressDemo = Card([progressStack], "Progress")
progressStack = Stack([pr1, pr2, pr3], "column", 3)
pr1 = Progress(25, "Quarter 1")
pr2 = Progress(60, "Quarter 2")
pr3 = Progress(95, "Quarter 3")

timelineDemo = Card([timelineInner], "Timeline")
timelineInner = Timeline([{date: "2026-05-25", title: "Library expansion", description: "39 components"}, {date: "2026-05-24", title: "Initial release", description: "9 base components"}, {date: "2026-05-23", title: "Project kickoff"}])

// ===== INTERACTIVE — statically rendered (7) =====
interH = Heading("Interactive — statically rendered (7)", 2)
interBody = Stack([buttonsCard, tabsCard, accordionCard, breadcrumbCard, tooltipCard, paginationCard, skeletonCard], "column", 4)

buttonsCard = Card([buttonsStack], "Button", "All 6 variants")
buttonsStack = Stack([btnDef, btnSec, btnOut, btnGhost, btnDestr, btnLink], "row", 2)
btnDef = Button("default")
btnSec = Button("secondary", "secondary")
btnOut = Button("outline", "outline")
btnGhost = Button("ghost", "ghost")
btnDestr = Button("destructive", "destructive")
btnLink = Button("link", "link")

tabsCard = Card([tabsInner], "Tabs", "Only first tab content shown")
tabsInner = Tabs([{label: "Overview", content: tabOv}, {label: "Details", content: tabDt}, {label: "Logs", content: tabLg}])
tabOv = Text("Tab 1 — Overview content.")
tabDt = Text("Tab 2 — Details content.")
tabLg = Text("Tab 3 — Logs content.")

accordionCard = Card([accordionInner], "Accordion", "Uses native <details>")
accordionInner = Accordion([{title: "Section A", content: accA}, {title: "Section B (list)", content: accB}, {title: "Section C (code)", content: accC}])
accA = Text("Body of section A.")
accB = BulletList(["Sub-item 1", "Sub-item 2", "Sub-item 3"])
accC = Code("Code as a content slot")

breadcrumbCard = Card([breadcrumbInner], "Breadcrumb")
breadcrumbInner = Breadcrumb([{text: "Home", href: "/"}, {text: "Section", href: "/section"}, {text: "Current"}])

tooltipCard = Card([tooltipRow], "Tooltip", "Browser-native title attribute")
tooltipRow = Stack([ttPre, tt, ttPost], "row", 2)
ttPre = Text("Hover")
tt = Tooltip("here", "This is a tooltip!")
ttPost = Text("to see the hint")

paginationCard = Card([paginationInner], "Pagination")
paginationInner = Pagination(3, 10)

skeletonCard = Card([skeletonInner], "Skeleton")
skeletonInner = Skeleton("100%", "1rem", 4)

// ===== MEDIA (3) =====
mediaH = Heading("Media (3)", 2)
mediaBody = Grid([imageCard, videoCard, iframeCard], 3, 4)

imageCard = Card([imageInner], "Image", "Image(src, alt?, rounded?)")
imageInner = Image("/icon.png", "Canvas Dock icon", true, 120, 120)

videoCard = Card([videoNote], "Video", "Video(src, poster?, autoplay?, loop?)")
videoNote = Text("Renders a <video> tag with controls. Provide a public mp4/webm URL.", true)

iframeCard = Card([iframeNote], "Iframe", "Iframe(src, title?, height?)")
iframeNote = Text("Embeds an external page. Useful for embedded dashboards, maps, etc.", true)

foot = Text("All 39 components rendered above. Source: samples/gallery.openui in the canvas-dock repo.", true)
