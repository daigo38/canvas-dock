root = Card([hdr, intro, stats, chartCard, tableCard, alert, controls, textCard], "Canvas Dock Gallery", "Only better-design-backed components are used")
hdr = SectionHeader("Better Design Catalog", "Canvas Dock now renders only vendored better-design components.", "lg")
intro = Text("No Stack, Grid, Hero, Image, Video, or other local Canvas Dock UI components are used in this sample.", "muted")
stats = Card([stat1, stat2, progress], "Metrics")
stat1 = StatCard("Revenue", "$1.2M", "+12%", "up", "vs previous quarter")
stat2 = StatCard("Churn", "2.1%", "-0.4pp", "down", "net retention improved")
progress = Progress(72)
chartCard = Card([chart], "Revenue Trend")
chart = Chart("bar", [{name: "Jan", value: 32}, {name: "Feb", value: 41}, {name: "Mar", value: 56}], "name", "value")
tableCard = Card([table], "Regions")
table = DataTable([{key: "region", header: "Region", sortable: true}, {key: "amount", header: "Amount"}], [{region: "JP", amount: "$420k"}, {region: "US", amount: "$610k"}])
alert = Alert([alertText], "Renderer policy", "default")
alertText = Text("Unsupported local components fail instead of falling back to custom UI.", "p")
controls = Card([button, badge, tip], "Interactive Surfaces")
button = Button("Open report", "default", "default", "https://www.better-design.com", true)
badge = Badge("better-design", "primary", "default")
tip = Tooltip("Policy", "Only better-design-backed entries are accepted.")
textCard = Card([h, quote, code, codeBlock, empty], "Typography")
h = Heading("Typography", 2)
quote = Quote("The catalog is intentionally smaller and stricter.")
code = Code("StatCard")
codeBlock = CodeBlock("root = Card([hdr], \"Demo\")", "openui", "example.openui")
empty = Empty("Nothing else to render", "Use better-design registry components only.")
